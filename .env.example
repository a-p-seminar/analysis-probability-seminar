# Copy configuration names into Netlify > Project configuration > Environment variables.
# Generate ADMIN_PASSWORD_HASH and SESSION_SECRET with: pnpm setup:admin
# ADMIN_PASSWORD_HASH is the initial password only. Changes in the admin UI are
# stored privately and take precedence without rewriting these variables.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
GITHUB_OWNER=a-p-seminar
GITHUB_REPO=analysis-probability-seminar
GITHUB_BRANCH=main
GITHUB_TOKEN=

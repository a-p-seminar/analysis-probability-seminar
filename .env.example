# Production: ADMIN_PASSWORD is the live, readable plaintext Netlify variable.
# Set it for Production, include Functions scope, and leave is_secret disabled.
# The server reads/writes this exact site's variable through the Netlify API.
ADMIN_PASSWORD=
NETLIFY_ENV_TOKEN=
NETLIFY_ACCOUNT_ID=
NETLIFY_SITE_ID=
# Local development only: pnpm setup:admin generates the initial hash and secret.
# Local changes remain in private local storage; they do not change the online password.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
GITHUB_OWNER=a-p-seminar
GITHUB_REPO=analysis-probability-seminar
GITHUB_BRANCH=main
GITHUB_TOKEN=
